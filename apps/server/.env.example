# Copy to apps/server/.env for local development. Do not commit .env.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# Any random string of 32+ characters. Never reuse a production secret here.
JWT_SECRET=
PORT=
# Optional: folder with the built web app (index.html). Default: apps/web/dist.
# WEB_DIST_DIR=
