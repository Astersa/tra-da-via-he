# Copy to apps/server/.env for local development. Do not commit .env.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# Any random string of 32+ characters. Never reuse a production secret here.
JWT_SECRET=
PORT=
# Comma-separated list of allowed web origins, e.g. http://localhost:5173
CORS_ORIGIN=
