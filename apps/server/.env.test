# Test values only. Used by the PostgreSQL test container (docker-compose.test.yml, port 5433).
DATABASE_URL=postgresql://tdvh:tdvh_test@localhost:5433/tdvh_test
# Concurrency tests need more connections than the default 5.
DB_POOL_MAX=20
# TEST ONLY - not a real secret. Never use this value outside tests.
JWT_SECRET=test-only-jwt-secret-do-not-use-in-production-0000
PORT=3001
